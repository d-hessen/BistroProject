<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="handlers.ClientDashboardController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label styleClass="header-label" text="Bistro Services" /> <Label fx:id="welcomeLabel" style="-fx-font-size: 14px;" text="Logged in as: Guest" /> <Separator />
      <VBox alignment="CENTER" spacing="12.0">
         <Button onAction="#handleCurrentVisit" prefHeight="45.0" prefWidth="250.0" text="Current Visit" /> <Button onAction="#handleGetTableNow" prefHeight="45.0" prefWidth="250.0" text="Get Table Now" />
         <Button onAction="#handleNewReservation" prefHeight="45.0" prefWidth="250.0" text="New Reservation" /> </VBox>
      <VBox fx:id="guestSection" alignment="CENTER" spacing="12.0">
         <Button onAction="#handleFindReservation" prefHeight="40.0" prefWidth="250.0" text="Find Reservation" /> </VBox>
      <VBox fx:id="memberSection" alignment="CENTER" spacing="12.0">
         <Button onAction="#handleMyReservations" prefHeight="40.0" prefWidth="250.0" text="My Reservations" /> 
         <Button onAction="#handleMyVisits" prefHeight="40.0" prefWidth="250.0" text="My Visits" /> 
         <Button onAction="#handleViewProfile" prefHeight="40.0" prefWidth="250.0" text="View Profile" />
      </VBox>
      <Button onAction="#handleLogout" styleClass="danger-button" text="Exit" /> </children>
</VBox>
