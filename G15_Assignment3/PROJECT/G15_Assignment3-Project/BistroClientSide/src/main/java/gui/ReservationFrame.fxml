<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="25" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="handlers.ReservationFrameController">
    <padding><Insets bottom="40" left="40" right="40" top="40" /></padding>
    <Label styleClass="header-label" text="Find Reservation" />
    <VBox spacing="15.0">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label prefWidth="120" text="Verification Code:" />
            <TextField fx:id="orderNumberField" promptText="Enter verification code" />
        </HBox>
    </VBox>
    <Button fx:id="findButton" onAction="#Find_Reservation" prefHeight="45.0" prefWidth="200.0" styleClass="primary-button" text="Find Reservation" />
    <Button fx:id="backBtn" onAction="#handleBackBtn" style="-fx-background-color: transparent;" text="Back" />
</VBox>
