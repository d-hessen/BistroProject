<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="350.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="handlers.IsMemberController">
   <children>
      <VBox alignment="CENTER" layoutX="25.0" layoutY="25.0" prefHeight="300.0" prefWidth="300.0" spacing="20">
         <children>
            <Label styleClass="header-label" text="Have Membership?" /> <Button onAction="#openClientOptions" prefWidth="180.0" styleClass="primary-button" text="Member Login" /> <Button onAction="#openGuestOptions" prefWidth="180.0" text="Join As Guest" /> <Button onAction="#handleBack" styleClass="danger-button" text="Back" /> </children>
      </VBox>
   </children>
</AnchorPane>
