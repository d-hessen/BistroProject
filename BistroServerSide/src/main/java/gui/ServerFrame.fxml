<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="850.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="domainLogic.ServerFrameController">
   
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="server-header">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="title" styleClass="header-label" text="Bistro Server Dashboard" />
                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <children>
                        <Label text="System Status:" style="-fx-text-fill: #7f8c8d;" />
                        <Label fx:id="statusLabel" styleClass="status-badge-off" text="OFFLINE" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="card" style="-fx-padding: 10 20;">
               <children>
                  <Label text="Port:" style="-fx-font-weight: bold;" />
                  <TextField fx:id="portField" prefWidth="70.0" text="5555" />
                  <Separator orientation="VERTICAL" prefHeight="20.0" />
                  <Button fx:id="btnStart" onAction="#onClickStart" styleClass="btn-start" text="▶ Start" />
                  <Button fx:id="btnStop" disable="true" onAction="#onClickStop" styleClass="btn-stop" text="■ Stop" />
               </children>
            </HBox>
         </children>
      </HBox>
   </top>

   <center>
      <HBox spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
         </padding>
         <children>
            <VBox spacing="15.0" HBox.hgrow="SOMETIMES" prefWidth="400.0" styleClass="card">
               <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
               <children>
                  <Label text="Active Connections" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                  <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colIp" text="IP Address" />
                      <TableColumn fx:id="colHost" text="Host" />
                      <TableColumn fx:id="colStatus" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
            
            <VBox spacing="15.0" HBox.hgrow="ALWAYS" styleClass="card">
               <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
               <children>
                  <Label text="Live Console Log" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                  <TextArea fx:id="consoleArea" editable="false" VBox.vgrow="ALWAYS" styleClass="terminal-area" />
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>