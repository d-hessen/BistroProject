<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="350.0" spacing="25.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="handlers.ClientWaitingController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <Label style="-fx-text-fill: #f57c00;" styleClass="header-label" text="Almost There!" /> <ProgressIndicator prefHeight="70.0" prefWidth="70.0" />
      <TextFlow textAlignment="CENTER">
         <children>
            <Text style="-fx-font-size: 16px;" text="We are currently preparing a table for you. Please have a seat in our waiting area." /> </children>
      </TextFlow>
      <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 15; -fx-background-color: #FFF8E1;" styleClass="card">
         <Label style="-fx-font-weight: bold; -fx-text-fill: #E65100;" text="Notification Settings" /> <Label text="You will receive an SMS and an app notification when your table is ready." textAlignment="CENTER" wrapText="true" /> </VBox>
      <HBox alignment="CENTER">
         <children> <Button onAction="#handleCancelWaiting" prefHeight="35.0" prefWidth="150.0" styleClass="danger-button" text="Cancel Waiting" />
            <Region prefHeight="38.0" prefWidth="36.0" />
            <Button onAction="#handleBack" prefHeight="38.0" prefWidth="95.0" styleClass="arrow-button" text="Back" />
         </children>
      </HBox> </children>
</VBox>
