<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="20.0" styleClass="card" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="handlers.MemberLoginController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <children>
      <Label styleClass="header-label" text="Member Login" /> 
      <VBox spacing="5.0">
         <Label text="Email or Phone" />
         <TextField fx:id="usernameField" promptText="Enter phone number/email" />
      </VBox>
      <VBox spacing="5.0">
         <Label text="Password" /> 
         <PasswordField fx:id="passwordField" promptText="Enter password" />
      </VBox>
      <Label fx:id="errorLabel" />
      <Button onAction="#handleLogin" prefWidth="200.0" styleClass="primary-button" text="Login" /> 
      <Button onAction="#handleBack" style="-fx-background-color: transparent;" text="Back" /> 
   </children>
</VBox>
