<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="420.0" spacing="25.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="handlers.VisitNowController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label styleClass="header-label" text="Get a Table Now" />
      <Label style="-fx-text-fill: #666666;" text="Enter details to receive your visit code" />
      <VBox spacing="15.0">
         <TextField fx:id="fullNameField" prefHeight="40.0" promptText="Full Name" />
         <TextField fx:id="contactField" prefHeight="40.0" promptText="Phone or Email" />
         <TextField fx:id="dinersField" prefHeight="40.0" promptText="Number of Diners" />
      </VBox>
      <Button fx:id="generateCodeBtn" onAction="#handleGenerateCode" prefHeight="45.0" prefWidth="250.0" styleClass="primary-button" text="Get Confirmation Code" />
      <VBox fx:id="confirmationArea" alignment="CENTER" spacing="10.0" visible="false" styleClass="card" style="-fx-padding: 20;">
         <Label text="Your Visit Code:" />
         <Label fx:id="generatedCodeLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1976D2;" text="XXXXXX" />
         <Label style="-fx-font-style: italic;" text="Present this at the entrance" />
      </VBox>
      <Button onAction="#handleBack" style="-fx-background-color: transparent;" text="Back" />
   </children>
</VBox>