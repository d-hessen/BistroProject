<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="20.0" styleClass="card" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="handlers.MemberProfileController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Label styleClass="header-label" text="My Profile" />
      <Separator prefWidth="200.0" />
      <VBox alignment="CENTER_LEFT" maxWidth="250.0" spacing="10.0">
         <children>
            <Label fx:id="nameLabel" text="Name: " /> <Label fx:id="phoneLabel" text="Phone: " /> <Label fx:id="emailLabel" text="Email: " /> </children>
      </VBox>
      <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Your Digital Card" /> <ImageView fx:id="digitalCardImageView" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" /> <Button onAction="#handleBack" prefWidth="120.0" text="Back" />
   </children>
</VBox>
