<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="handlers.MemberProfileController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Label text="My Profile">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Separator prefWidth="200.0" />
      <VBox alignment="CENTER_LEFT" maxWidth="250.0" spacing="10.0">
         <children>
            <Label fx:id="nameLabel" style="-fx-font-size: 14px;" text="Name: " />
            <Label fx:id="phoneLabel" style="-fx-font-size: 14px;" text="Phone: " />
            <Label fx:id="emailLabel" style="-fx-font-size: 14px;" text="Email: " />
         </children>
      </VBox>
      <Separator prefWidth="200.0" />
      <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Your Digital Card" />
      <ImageView fx:id="digitalCardImageView" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 0);" />
      <Separator prefWidth="200.0" />
      <Button mnemonicParsing="false" onAction="#handleBack" prefWidth="100.0" text="Back" />
   </children>
</VBox>